{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pantry-work",
  "main": "src/worker.ts",
  "account_id": "31b91e7f9954ad8aa334d46f012bd8ed",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [{ "pattern": "pantry.ax.cloudflare.dev", "custom_domain": true }],
  "assets": {
    "directory": "./app/dist/ops",
    "binding": "APP_ASSETS",
    "run_worker_first": ["/health", "/recipes", "/recipes/*", "/recipe/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pantry-db",
      "database_id": "e7c3ab28-b74d-4a0f-92c4-091ad855ccef",
      "migrations_dir": "migrations",
      "remote": true
    }
  ],
  "vars": {
    "PANTRY_SHARED_OWNER": "jcoeyman@cloudflare.com",
    "PANTRY_ACCESS_SHARE_ALL": "true",
    "PANTRY_ACCESS_ONLY": "true",
    "PANTRY_EMPLOYEE_WORKSPACE_ENABLED": "false",
    "PANTRY_EMPLOYEE_WORKSPACE_SLUG": "cloudflare-employees",
    "PANTRY_AUTHORIZATION_POLICY_VERSION": "employee-v1"
  }
}
